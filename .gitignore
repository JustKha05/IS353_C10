!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# Windows & macOS metadata
Thumbs.db
desktop.ini
ehthumbs.db
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

